{
  "name": "tieout",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Tieout hackathon monorepo",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter \"@tieout/*\" build && tsc --noEmit",
    "test": "pnpm --filter \"@tieout/*\" build && vitest run",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "tsx scripts/run-fixtures.ts",
    "check:contract": "node --experimental-strip-types scripts/check-api-contract.ts",
    "check:local-dependencies": "node --experimental-strip-types scripts/check-local-dependencies.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "storage:setup": "tsx scripts/ensure-bucket.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:reset": "tsx scripts/seed-demo.ts --reset",
    "check:neon": "tsx scripts/check-neon-persistence.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "db:ping": "tsx scripts/check-db-connectivity.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@tieout/rules": "workspace:*",
    "@tieout/schema": "workspace:*",
    "@tieout/test-fixtures": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "jose": "^6.2.9",
    "js-yaml": "^5.3.0",
    "jsdom": "^24.1.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "prettier": "^3.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3"
  }
}
