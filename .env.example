# Local development environment template
# Copy to .env.local and customize values

# Node environment
NODE_ENV=development

# PostgreSQL
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/tieout
# Neon (remote): use the project connection string, e.g.
#   postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/tieout?sslmode=require
# (sslmode=require is required by Neon; the postgres driver honours it.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tieout

# Object storage (S3-compatible)
# Local MinIO:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Cloudflare R2 (remote):
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=<r2-access-key-id>
#   S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# App
APP_BASE_URL=http://localhost:3000

# Demo identity (seeded org/user)
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ORG_ID=00000000-0000-0000-0000-000000000002

# LLM (optional, for extraction)
# OPENAI_API_KEY=sk_...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo-preview
# GEMINI_API_KEY=
# EXTRACTION_MODEL=gemini-2.5-flash
# EXTRACTION_FALLBACK=fixture

# Data providers
# EPFO_PROVIDER=fixture

# Logging
LOG_LEVEL=info

# Demo mode (compress timeouts for testing)
DEMO_MODE=false
