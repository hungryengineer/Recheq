# Local development environment template
# Copy to .env.local and customize values

# Node environment
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tieout

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# LLM (optional, for extraction)
# OPENAI_API_KEY=sk_...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo-preview

# Logging
LOG_LEVEL=info

# Demo mode (compress timeouts for testing)
DEMO_MODE=false
