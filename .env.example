# Local development environment template
# Copy to .env.local and customize values

# Node environment
NODE_ENV=development

# PostgreSQL
# Local (docker compose): postgresql://postgres:postgres@localhost:5432/tieout
# Neon (remote): use the project connection string, e.g.
#   postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/tieout?sslmode=require
# (sslmode=require is required by Neon; the postgres driver honours it.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tieout

# Object storage (S3-compatible)
# Local MinIO:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Backblaze B2 (remote):
#   S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   S3_ACCESS_KEY_ID=<b2-key-id>
#   S3_SECRET_ACCESS_KEY=<b2-application-key>
#   S3_REGION=<b2-account-region> (e.g. us-west-004 — use your account region, NOT "auto")
#   S3_BUCKET=<globally-unique-bucket-name>
#   S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025

# App
APP_BASE_URL=http://localhost:3000

# Demo identity (seeded org/user)
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ORG_ID=00000000-0000-0000-0000-000000000002

# LLM extraction
# Provider: set GEMINI_API_KEY to use Gemini (recommended for demo).
# EXTRACTION_MODEL selects the model — use Flash-tier for cost and speed.
# EXTRACTION_FALLBACK=fixture activates the safety valve: if Gemini fails both
# attempts (primary + one schema-retry), the fixture extractor serves the result
# instead of failing the case. The fallback is logged loudly and recorded in
# extractions.model_id as "fixture-fallback:<model>" so it is never hidden.
# Set to "fixture" only for demo/dev runs. Leave empty in production.
EXTRACTION_FALLBACK=
EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# EPFO_PROVIDER=fixture

# Logging
LOG_LEVEL=info

# Demo mode (compress timeouts for testing)
DEMO_MODE=false
